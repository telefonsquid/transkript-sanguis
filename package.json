{
	"name": "transkript-sanguis",
	"private": true,
	"version": "1.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:e2e": "playwright install && playwright test",
		"test:unit": "bun test src",
		"test": "bun run test:unit && bun run test:e2e",
		"version:set": "bun scripts/set-version.ts",
		"release-notes": "bun scripts/release-notes.ts",
		"rename-release-assets": "bun scripts/rename-release-assets.ts",
		"release-downloads": "bun scripts/release-downloads.ts",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0-next.4",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/cli": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"@types/bun": "^1.4.2",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
